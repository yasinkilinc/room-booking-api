{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Room Booking API",
    "description" : "Book meeting rooms without double bookings. Get a token from POST /api/auth/token and send it as a Bearer token.",
    "version" : "1.0.0"
  },
  "servers" : [ {
    "url" : "http://localhost:8080",
    "description" : "Local run with docker compose"
  } ],
  "security" : [ {
    "bearer" : [ ]
  } ],
  "paths" : {
    "/api/rooms" : {
      "get" : {
        "tags" : [ "Rooms" ],
        "summary" : "List all rooms",
        "operationId" : "list",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/RoomResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "Rooms" ],
        "summary" : "Create a room (admin only)",
        "operationId" : "create",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateRoomRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RoomResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings" : {
      "get" : {
        "tags" : [ "Bookings" ],
        "summary" : "My bookings that have not ended yet, soonest first",
        "operationId" : "upcoming",
        "parameters" : [ {
          "name" : "pageable",
          "in" : "query",
          "required" : true,
          "schema" : {
            "$ref" : "#/components/schemas/Pageable"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseBookingResponse"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "Bookings" ],
        "summary" : "Book a room",
        "description" : "Returns 409 when the room is already booked at that time.",
        "operationId" : "create_1",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateBookingRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Booked",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BookingResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid fields or a broken rule (capacity, 15-minute grid, past start)",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409" : {
            "description" : "The room is already booked at that time; the body names the conflicting booking",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/token" : {
      "post" : {
        "tags" : [ "Auth" ],
        "summary" : "Exchange username and password for a bearer token",
        "operationId" : "token",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms/{id}" : {
      "get" : {
        "tags" : [ "Rooms" ],
        "summary" : "Get one room",
        "operationId" : "get",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RoomResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms/{id}/schedule" : {
      "get" : {
        "tags" : [ "Rooms" ],
        "summary" : "Confirmed bookings of a room in a time range (at most 31 days)",
        "operationId" : "schedule",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        }, {
          "name" : "from",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "date-time"
          }
        }, {
          "name" : "to",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "date-time"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/BookingResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{id}" : {
      "get" : {
        "tags" : [ "Bookings" ],
        "summary" : "Get one of my bookings (admins can get any)",
        "operationId" : "get_1",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BookingResponse"
                }
              }
            }
          }
        }
      },
      "delete" : {
        "tags" : [ "Bookings" ],
        "summary" : "Cancel a booking before it starts (owner or admin)",
        "description" : "Cancelling an already cancelled booking also returns 204, so retries are safe.",
        "operationId" : "cancel",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Cancelled"
          },
          "403" : {
            "description" : "The booking belongs to another user",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409" : {
            "description" : "The booking has already started",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "CreateRoomRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 0
          },
          "capacity" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 500,
            "minimum" : 1
          }
        },
        "required" : [ "capacity", "name" ]
      },
      "RoomResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "name" : {
            "type" : "string"
          },
          "capacity" : {
            "type" : "integer",
            "format" : "int32"
          },
          "active" : {
            "type" : "boolean"
          }
        }
      },
      "CreateBookingRequest" : {
        "type" : "object",
        "properties" : {
          "roomId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "title" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "attendees" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 1
          },
          "startsAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "endsAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "attendees", "endsAt", "roomId", "startsAt", "title" ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "type" : {
            "type" : "string",
            "format" : "uri"
          },
          "title" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : { }
          }
        }
      },
      "BookingResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "roomId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "roomName" : {
            "type" : "string"
          },
          "bookedBy" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          },
          "attendees" : {
            "type" : "integer",
            "format" : "int32"
          },
          "startsAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "endsAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "CONFIRMED", "CANCELLED" ]
          }
        }
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "username" : {
            "type" : "string",
            "minLength" : 1
          },
          "password" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "password", "username" ]
      },
      "TokenResponse" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "tokenType" : {
            "type" : "string"
          },
          "expiresIn" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
      "Pageable" : {
        "type" : "object",
        "properties" : {
          "page" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 0
          },
          "size" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 1
          },
          "sort" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        }
      },
      "PageResponseBookingResponse" : {
        "type" : "object",
        "properties" : {
          "content" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/BookingResponse"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}